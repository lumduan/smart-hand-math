# Copy to .env and adjust. All variables MUST be prefixed with VITE_ to be exposed to the browser.

# Where the MediaPipe hand-landmarker model/wasm assets are served from.
# Default: self-hosted in /public/models (Phase 6) — no CDN egress, works offline.
# (To use the CDN instead, set these to the Google/jsDelivr URLs.)
VITE_MEDIAPIPE_MODEL_URL=/models/hand_landmarker.task
VITE_MEDIAPIPE_WASM_URL=/models/wasm

# Default app volume (0..1)
VITE_DEFAULT_VOLUME=0.6
