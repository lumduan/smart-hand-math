# Copy to .env and adjust. All variables MUST be prefixed with VITE_ to be exposed to the browser.

# Where the MediaPipe hand-landmarker model/wasm assets are served from.
# Default: Google CDN. Set to "/models" to use the self-hosted copies in /public/models.
VITE_MEDIAPIPE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task
VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision/wasm

# Default app volume (0..1)
VITE_DEFAULT_VOLUME=0.6
